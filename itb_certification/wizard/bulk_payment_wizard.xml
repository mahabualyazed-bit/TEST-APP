<odoo>
    <record id="view_certificate_bulk_payment_wizard_form" model="ir.ui.view">
        <field name="name">itb.certificate.bulk.payment.wizard.form</field>
        <field name="model">itb.certificate.bulk.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <field name="payment" widget="radio"/>
                    <field name="payment_type" widget="radio" invisible="payment != 'direct_payment'" required="payment == 'direct_payment'"/>
                    <field name="certificate_date" invisible="payment != 'payroll'" required="payment == 'payroll'"/>
                    <field name="amount" readonly="1"/>
                </group>
                <footer>
                    <button name="action_create_payment"
                            type="object"
                            string="Create"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_certificate_bulk_payment_wizard" model="ir.actions.act_window">
        <field name="name">Register Payment</field>
        <field name="res_model">itb.certificate.bulk.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_certificate_bulk_register_payment" model="ir.actions.server">
        <field name="name">Register Payment</field>
        <field name="model_id" ref="model_itb_certificate"/>
        <field name="binding_model_id" ref="model_itb_certificate"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records_to_pay = records.filtered(lambda r: r.state == 'refunded' and r.payment_state == 'not_paid')
if len(records_to_pay) != len(records):
    raise UserError('All selected records must be Refunded and Not Paid to register payment.')
if records_to_pay:
    total = sum(records_to_pay.mapped('certificate_amount'))
    action = env['ir.actions.act_window']._for_xml_id('itb_certification.action_certificate_bulk_payment_wizard')
    action['context'] = {
        'default_certificate_ids': records_to_pay.ids,
        'default_amount': total,
    }
        </field>
    </record>
</odoo>