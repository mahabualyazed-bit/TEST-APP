<odoo noupdate="1">
    <record id="mail_template_certificate_refund" model="mail.template">
        <field name="name">Certificate: Refund Notification</field>
        <field name="model_id" ref="itb_certification.model_itb_certificate"/>
        <field name="subject">Certificate Refund - {{ object.employee_id.name }}</field>
        <field name="email_to">{{ ctx.get('email_to', '') }}</field>
        <field name="body_html"><![CDATA[
            <p>Hello <t t-out="ctx.get('accounting_name', 'Sir/Madam')"/>,</p>
            <p>The following certificate has been refunded and requires your action:</p>
            <ul>
            <li><strong>Certificate:</strong> <a t-attf-href="#{ctx.get('record_url')}"><t t-out="object.certification_id.certificate_name"/></a></li>
                <li><strong>Employee:</strong> <t t-out="object.employee_id.name"/></li>
                <li><strong>Amount:</strong> <t t-out="object.certificate_amount"/></li>
            </ul>
        ]]></field>
    </record>
</odoo>