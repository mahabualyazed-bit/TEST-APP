<odoo>
    <record id="view_itb_certification_list" model="ir.ui.view">
        <field name="name">itb.certification.list</field>
        <field name="model">itb.certification</field>
        <field name="arch" type="xml">
            <list>
                <field name="certificate_name"/>
                <field name="certificate_category"/>
                <field name="certificate_amount"/>
                <field name="department_id" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_itb_certification_form" model="ir.ui.view">
        <field name="name">itb.certification.form</field>
        <field name="model">itb.certification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="certificate_name"/>
                        <field name="certificate_category" options="{'no_create': True}"/>
                        <field name="certificate_amount"/>
                        <field name="department_id" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_itb_certification" model="ir.actions.act_window">
        <field name="name">Certification</field>
        <field name="res_model">itb.certification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>